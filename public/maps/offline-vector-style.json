{
  "version": 8,
  "name": "Tuzla Offline Vector Style",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "tuzla-pmtiles": {
      "type": "vector",
      "url": "pmtiles:///maps/tuzla.pmtiles",
      "minzoom": 0,
      "maxzoom": 15
   
    },
    "app-pois": {
      "type": "geojson",
      "data": "/maps/poi.geojson"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#0f172a"
      }
    },
    {
      "id": "pmtiles-landuse",
      "type": "fill",
      "source": "tuzla-pmtiles",
      "source-layer": "landuse",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "fill-color": "#1e293b",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "pmtiles-water",
      "type": "fill",
      "source": "tuzla-pmtiles",
      "source-layer": "water",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "fill-color": "#0284c7",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "pmtiles-roads",
      "type": "line",
      "source": "tuzla-pmtiles",
      "source-layer": "roads",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "line-color": "#334155",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0, 0.5,
          10, 1.5,
          14, 3,
          18, 8
        ]
      }
    },
    {
      "id": "pmtiles-buildings",
      "type": "fill-extrusion",
      "source": "tuzla-pmtiles",
      "source-layer": "buildings",
      "minzoom": 13,
      "maxzoom": 18,
      "paint": {
        "fill-extrusion-color": "#334155",
        "fill-extrusion-height": ["coalesce", ["get", "render_height"], ["get", "height"], 12],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], ["get", "min_height"], 0],
        "fill-extrusion-opacity": 0.8
      }
    },
    {
      "id": "app-buildings-3d",
      "type": "fill-extrusion",
      "source": "app-buildings",
      "minzoom": 13,
      "maxzoom": 18,
      "paint": {
        "fill-extrusion-color": [
          "interpolate",
          ["linear"],
          ["coalesce", ["get", "height"], 14],
          0, "#3b82f6",
          15, "#1d4ed8",
          30, "#1e40af",
          60, "#1e3a8a"
        ],
        "fill-extrusion-height": [
          "coalesce",
          ["get", "height"],
          14
        ],
        "fill-extrusion-base": [
          "coalesce",
          ["get", "min_height"],
          0
        ],
        "fill-extrusion-opacity": 0.85,
        "fill-extrusion-vertical-gradient": true
      }
    },
    {
      "id": "tour-route-line",
      "type": "line",
      "source": "tour-data",
      "minzoom": 0,
      "maxzoom": 18,
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": 4,
        "line-opacity": 0.8,
        "line-dasharray": [
          2,
          1
        ]
      }
    },
    {
      "id": "tour-points",
      "type": "circle",
      "source": "tour-data",
      "minzoom": 0,
      "maxzoom": 18,
      "filter": [
        "==",
        "$type",
        "Point"
      ],
      "paint": {
        "circle-radius": 5,
        "circle-color": "#8b5cf6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    },
    {
      "id": "poi-icons",
      "type": "circle",
      "source": "app-pois",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "circle-radius": 8,
        "circle-color": "#3b82f6",
        "circle-stroke-width": 2,
        "circle-stroke-color": "#ffffff"
      }
    }
  ]
}
