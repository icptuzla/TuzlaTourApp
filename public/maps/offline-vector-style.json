{
  "version": 8,
  "name": "Tuzla Offline Vector Style",
  "metadata": {
    "maputnik:renderer": "mlgljs"
  },
  "sources": {
    "tuzla-pmtiles": {
      "type": "vector",
      "url": "pmtiles:///maps/tuzla.pmtiles",
      "minzoom": 0,
      "maxzoom": 18
    },
    "app-pois": {
      "type": "geojson",
      "data": "/maps/poi.geojson"
    },
    "tour-data": {
      "type": "geojson",
      "data": {
        "type": "FeatureCollection",
        "features": []
      }
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#cceb94"
      }
    },
    {
      "id": "pmtiles-landuse",
      "type": "fill",
      "source": "tuzla-pmtiles",
      "source-layer": "landuse",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "fill-color": "#d1c88c",
        "fill-opacity": 0.5
      }
    },
    {
      "id": "pmtiles-water",
      "type": "fill",
      "source": "tuzla-pmtiles",
      "source-layer": "water",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "fill-color": "#2891e0",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "pmtiles-waterways",
      "type": "line",
      "source": "tuzla-pmtiles",
      "source-layer": "water",
      "minzoom": 8,
      "maxzoom": 18,
      "filter": ["==", "$type", "LineString"],
      "paint": {
        "line-color": "#2891e0",
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 14, 2, 18, 5],
        "line-opacity": 0.55
      }
    },
    {
      "id": "pmtiles-roads-casing",
      "type": "line",
      "source": "tuzla-pmtiles",
      "source-layer": "roads",
      "minzoom": 0,
      "maxzoom": 18,
      "paint": {
        "line-color": "#b28b62",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          0,
          0.5,
          10,
          2.5,
          14,
          4.5,
          18,
          12
        ]
      }
    },
    {
      "id": "pmtiles-roads",
      "type": "line",
      "source": "tuzla-pmtiles",
      "source-layer": "roads",
      "minzoom": 3,
      "maxzoom": 18,
      "paint": {
        "line-color": [
          "match",
          ["get", "kind"],
          "highway", "#f2c879",
          "major_road", "#f7d78d",
          "minor_road", "#fff4d6",
          "path", "#d8c7a6",
          "#eadcc4"
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 10, 1.2, 14, 2.5, 18, 7]
      }
    },
    {
      "id": "pmtiles-buildings",
      "type": "fill-extrusion",
      "source": "tuzla-pmtiles",
      "source-layer": "buildings",
      "minzoom": 13,
      "maxzoom": 18,
      "paint": {
        "fill-extrusion-color": "#dbdad7",
        "fill-extrusion-height": [
          "coalesce",
          [
            "get",
            "render_height"
          ],
          [
            "get",
            "height"
          ],
          12
        ],
        "fill-extrusion-base": [
          "coalesce",
          [
            "get",
            "render_min_height"
          ],
          [
            "get",
            "min_height"
          ],
          0
        ],
        "fill-extrusion-opacity": 0.8
      }
    },
    {
      "id": "tour-route-line",
      "type": "line",
      "source": "tour-data",
      "minzoom": 0,
      "maxzoom": 18,
      "filter": [
        "==",
        "$type",
        "LineString"
      ],
      "paint": {
        "line-color": "#3b82f6",
        "line-width": 4,
        "line-opacity": 0.8,
        "line-dasharray": [
          2,
          1
        ]
      }
   }   
  ] 
  }